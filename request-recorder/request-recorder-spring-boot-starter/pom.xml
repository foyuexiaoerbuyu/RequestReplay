<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.requestrecorder</groupId>
        <artifactId>request-recorder-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>request-recorder-spring-boot-starter</artifactId>
    <name>request-recorder-spring-boot-starter</name>
    <description>Spring Boot 版本无关的公共自动装配：配置属性、核心 Bean、生命周期</description>

    <properties>
        <maven.compiler.release>8</maven.compiler.release>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.requestrecorder</groupId>
            <artifactId>request-recorder-core</artifactId>
        </dependency>

        <!-- 仅编译期依赖 Spring Boot 2.7 的稳定 API，运行期由业务工程提供（Boot 2.x / 3.x 二进制兼容） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
            <version>${spring-boot-2.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <version>${spring-boot-2.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
